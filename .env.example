# LIVE_KILL_SWITCH=true
# MAX_LIVE_NOTIONAL_USD=100
# MAX_LIVE_POSITIONS=2
# MAX_LIVE_LEVERAGE=3
# MAX_LIVE_ENTRY_DRIFT_PCT=0.25
